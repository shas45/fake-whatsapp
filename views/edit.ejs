<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Chat</title>
</head>
<body>
    <h3>Edit Chat: <%= chat._id %></h3>
    <P>This chat was send from <b><%= chat.from %></b> to <b><%= chat.to %></b></P>
    
    <form action="/chats/<%= chat._id %>/update" method="POST">
        <textarea name="message" rows="10" cols="40"><%= chat.message %></textarea><br>
        <button type="submit">Edit</button>
    </form>
    
</body>
</html>